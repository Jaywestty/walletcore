# Local configuration. Copy to .env and adjust.
# Never commit a real .env.

# Server
HTTP_ADDR=:8080

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For. Leave false otherwise.
TRUST_PROXY_HEADERS=false

# Database
DATABASE_URL=postgres://walletcore:walletcore@localhost:5432/walletcore?sslmode=disable
DATABASE_TEST_URL=postgres://walletcore:walletcore@localhost:5433/walletcore_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# Auth. Required API key for write endpoints.
API_KEY=dev-api-key-change-me

# Ledger posting behaviour.
# How long a posting waits for a row lock before failing.
LEDGER_LOCK_TIMEOUT=5s
# Maximum automatic retries for deadlock or serialization failures (0 disables).
LEDGER_MAX_RETRIES=3
